root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows batch is pinned to CRLF in .gitattributes.
[*.cmd]
end_of_line = crlf

[*.sh]
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false
